# Copy to .env and fill in. .env is git-ignored.

# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Locally that's the Vite dev server, which proxies /api.
BETTER_AUTH_URL=http://localhost:3000

# Database. Locally: a PGlite data folder. Production: set DATABASE_URL to a PostgreSQL server
# (Neon pooled connection string, ...?sslmode=require); it wins over DATABASE_DIR when set.
DATABASE_DIR=./.data/pglite
# DATABASE_URL=

# Optional: Google sign-in. Create an OAuth client (Web application) in Google Cloud Console.
# GOOGLE_REDIRECT_URI must exactly match one of its "Authorized redirect URIs".
# Default when empty: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Optional: send magic links by email over SMTP. Without it, links are printed in the API console.
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (spaces are ignored).
# Gmail sends up to ~500 emails/day and always shows your Gmail address as the sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to "Splity <SMTP_USER>".
EMAIL_FROM=

# Optional: Web Push notifications. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Keep the same keys forever: changing them invalidates every device's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# "Today" for recurring expenses.
APP_TIMEZONE=Asia/Kolkata
# Optional: protects POST /api/cron/recurring for an external scheduler (e.g. Vercel Cron).
# Locally the API server runs the recurring job by itself every hour.
CRON_SECRET=
