# Copy to .env and fill in. .env is git-ignored.

# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Locally that's the Vite dev server, which proxies /api.
BETTER_AUTH_URL=http://localhost:3000

# Local PGlite data folder
DATABASE_DIR=./.data/pglite

# Optional: Google sign-in. Create an OAuth client (Web application) in Google Cloud Console.
# GOOGLE_REDIRECT_URI must exactly match one of its "Authorized redirect URIs".
# Default when empty: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Optional: send magic links by email. Without it, links are printed in the API console.
RESEND_API_KEY=
EMAIL_FROM=Splity <login@your-domain.com>
